@model IEnumerable<ProductRegistrationSystem.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="products-page">
    <div class="page-header">
        <div>
            <h1>Каталог товаров</h1>
            <p>Управление ассортиментом и складом</p>
        </div>
        <a asp-action="Create" class="btn-primary">+ Добавить товар</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="get" class="filter-form">
        <input type="text" name="search"
               value="@ViewBag.Search"
               placeholder="Поиск товаров..." />

        <select name="category">
            <option value="">Все категории</option>
            @foreach (var item in ViewBag.Categories)
            {
                <option value="@item"
                        selected="@(ViewBag.Category == item)">
                    @item
                </option>
            }
        </select>

        <button type="submit" class="btn-primary">Поиск</button>
        <a asp-action="Index" class="btn-secondary">Сброс</a>
    </form>

    <div class="table-wrapper">
        <table class="products-table">
            <thead>
                <tr>
                    <th>Товар</th>
                    <th>Категория</th>
                    <th>Цена</th>
                    <th>Количество</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         class="product-image" />
                                }
                                else
                                {
                                    <div class="product-placeholder">P</div>
                                }

                                <div>
                                    <strong>@product.Name</strong>
                                    <small>ID: @product.Id</small>
                                </div>
                            </div>
                        </td>

                        <td>@product.Category</td>

                        <td>@product.Price.ToString("N2") ₸</td>

                        <td>@product.StockQuantity</td>

                        <td>
                            @if (product.IsActive)
                            {
                                <span class="status-active">Активен</span>
                            }
                            else
                            {
                                <span class="status-inactive">Неактивен</span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn-icon"
                                   title="Просмотр">Просмотр</a>

                                <a asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn-icon"
                                   title="Редактировать">Изменить</a>

                                <a asp-action="Delete"
                                   asp-route-id="@product.Id"
                                   class="btn-danger"
                                   title="Удалить">Удалить</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>Товары не найдены</h3>
            <p>Добавьте первый товар в каталог.</p>
        </div>
    }
</div>
