@model ProductRegistrationSystem.Models.Product

@{
    ViewData["Title"] = "Удаление товара";
}

<div class="form-page">
    <div class="form-header">
        <h1>Удаление товара</h1>
        <p>Вы уверены, что хотите удалить этот товар?</p>
    </div>

    <div class="delete-card">
        <h3>@Model.Name</h3>
        <p>Категория: @Model.Category</p>
        <p>Цена: @Model.Price.ToString("N2") ₸</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="form-actions">
                <button type="submit" class="btn-danger">
                    Подтвердить удаление
                </button>

                <a asp-action="Index" class="btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>
