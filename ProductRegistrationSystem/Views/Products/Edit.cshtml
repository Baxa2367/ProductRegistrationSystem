@model ProductRegistrationSystem.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Редактирование товара";
}

<div class="form-page">
    <div class="form-header">
        <h1>Редактирование товара</h1>
        <p>Измените данные товара</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id"
          method="post" class="product-form">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name">Название товара</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Описание</label>
            <textarea asp-for="Description" rows="4"></textarea>
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Category">Категория</label>
            <input asp-for="Category" />
            <span asp-validation-for="Category" class="validation-error"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Price">Цена (₸)</label>
                <input asp-for="Price" type="number" step="0.01" />
                <span asp-validation-for="Price" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="StockQuantity">Количество</label>
                <input asp-for="StockQuantity" type="number" />
                <span asp-validation-for="StockQuantity" class="validation-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ImageUrl">URL изображения</label>
            <input asp-for="ImageUrl" />
            <span asp-validation-for="ImageUrl" class="validation-error"></span>
        </div>

        <div class="form-group checkbox-group">
            <input asp-for="IsActive" />
            <label asp-for="IsActive">Активный товар</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Сохранить изменения</button>
            <a asp-action="Index" class="btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
